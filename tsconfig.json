{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "@@/*": [".dumi/tmp/*"],
      "@/*": ["src/*"]
    },
    "typeRoots": [
      "node_modules/@types",
      "typing.d.ts" // 指向你的类型声明文件
    ]
  },
  "include": [".dumirc.ts", "src/*", "typing.d.ts"]
}
